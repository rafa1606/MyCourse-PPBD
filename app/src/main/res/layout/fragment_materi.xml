<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Materi Praktikum"
            style="@style/CustomTextView18Bold"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Pertemuan 1 Android Studio"
            android:textSize="16sp"
            android:textColor="#222222"
            android:padding="16dp"
            android:background="@drawable/rounded_card"
            android:layout_marginBottom="12dp" />

        <TextView
            android:textColor="#222222"
            android:background="@drawable/rounded_card"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Pertemuan 2 Linear Layout"
            android:textSize="16sp"
            android:padding="12dp" />

        <TextView
            android:textColor="#222222"
            android:background="@drawable/rounded_card"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Pertemuan 3 RelativeLayout"
            android:textSize="16sp"
            android:padding="12dp" />

        <TextView
            android:textColor="#222222"
            android:background="@drawable/rounded_card"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Pertemuan 4 ConstraintLayout"
            android:textSize="16sp"
            android:padding="12dp" />

        <TextView
            android:textColor="#222222"
            android:background="@drawable/rounded_card"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5. Pertemuan 5 Activity &amp; Intent"
            android:textSize="16sp"
            android:padding="12dp" />

        <TextView
            android:textColor="#222222"
            android:background="@drawable/rounded_card"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="6. Pertemuan 6 UI Component"
            android:textSize="16sp"
            android:padding="12dp" />

        <TextView
            android:textColor="#222222"
            android:background="@drawable/rounded_card"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="7. Pertemuan 7 Style, Option Menu &amp; Tabs Layout"
            android:textSize="16sp"
            android:padding="12dp" />

    </LinearLayout>

</ScrollView>